{
  "name": "ox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "biome check --error-on-warnings . && tsc && tsc -p e2e",
    "fix": "biome check --write .",
