{
  "name": "@kkestell/ox-client",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tailwindcss --input ./src/styles.css --output ./public/styles.css && bun build ./src/browser.tsx --outdir ./public --target browser",
    "check": "bun run build && tsc --noEmit",
    "start": "bun run ./src/host.ts",
    "test": "bun test --path-ignore-patterns 'e2e/**'",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@tailwindcss/cli": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
