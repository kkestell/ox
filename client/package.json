{
  "name": "@kkestell/ox-client",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/browser.tsx --outdir ./public --target browser",
    "check": "tsc --noEmit",
    "start": "bun run ./src/host.ts",
    "test": "bun test ./src/protocol.test.ts ./src/host.test.ts ./src/session-controller.test.ts ./src/workspace-supervisor.test.ts",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
