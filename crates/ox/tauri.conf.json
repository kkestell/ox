{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ox",
  "version": "0.1.0",
  "identifier": "com.kkestell.ox",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ox",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
